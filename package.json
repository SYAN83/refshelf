{
  "name": "bibliotek",
  "version": "0.1.0",
  "private": true,
  "description": "Local reference manager: import papers, preview PDFs, AI summaries, BibTeX/APA/MLA export",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^4.5.7",
    "google-auth-library": "^11.3.2",
    "marked": "^14.1.4",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.10.38"
  }
}
